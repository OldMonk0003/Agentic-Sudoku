# npm's peer-resolution (arborist) crashes with "Cannot read properties of null
# (reading 'edgesOut')" while walking vitest's OPTIONAL peer graph -- @vitest/browser
# pulls webdriverio and @vitest/ui, none of which this project uses.
#
# This flag skips that resolution path. It is a workaround for an npm bug, not a
# licence to ignore real peer conflicts: if a genuine version conflict appears,
# fix it in package.json rather than leaning on this.
legacy-peer-deps=true
